{
  "@context": {
    "@version": 1.1,
    "ll": "https://loopledger.org/ns/v0.1#",
    "untp-dpp": "https://test.uncefact.org/vocabulary/untp/dpp/0.7.0/",
    "epcis": "https://ref.gs1.org/epcis/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "Passport": "ll:Passport",
    "Event": "ll:Event",
    "passport_id": "ll:passport_id",
    "asset_id": { "@id": "ll:asset_id", "@type": "@id" },
    "owner": "ll:owner",
    "manufacturer": "untp-dpp:manufacturer",
    "designer": "ll:designer",
    "carrier": "ll:carrier",
    "digital_link": { "@id": "ll:digital_link", "@type": "@id" },
    "revision": "ll:revision",
    "components": { "@id": "ll:components", "@container": "@set" },
    "joints": {
      "@id": "ll:joints",
      "@container": "@set",
      "@context": { "type": { "@id": "ll:joint_type", "@type": "@id" } }
    },
    "composition": { "@id": "ll:composition", "@container": "@set" },
    "material": { "@id": "ll:material", "@type": "@id" },
    "external_refs": { "@id": "ll:external_refs", "@type": "@id", "@container": "@set" },
    "status": "ll:status",
    "lifecycle": "ll:lifecycle",
    "event_type": "ll:event_type",
    "occurred_at": { "@id": "epcis:eventTime", "@type": "xsd:dateTime" },
    "recorded_at": { "@id": "epcis:recordTime", "@type": "xsd:dateTime" },
    "payload": "ll:payload",
    "signatures": { "@id": "ll:signatures", "@container": "@set" },
    "evidence": { "@id": "ll:evidence", "@container": "@set" },
    "cause": "ll:cause"
  }
}
