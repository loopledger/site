{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loopledger.org/schema/v0.1/passport.schema.json",
  "title": "LoopLedger asset passport v0.1",
  "$comment": "Community Specification License 1.0 (LL-002). Aligned to UNTP DPP 0.7.0 (no 1.0 release confirmed when this was written); see context.jsonld. Carrier and identifier follow ISO/IEC 15459 and the harmonised EU DPP standards (EN 18219-18222). Vocabulary-backed fields are checked for IRI shape only; membership in the published scheme is checked from #18.",
  "type": "object",
  "required": ["@context", "@type", "asset_id", "passport_id", "tenant_id", "kind", "revision", "owner", "origin"],
  "additionalProperties": false,
  "properties": {
    "@context": {
      "type": "array",
      "contains": { "const": "https://loopledger.org/schema/v0.1/context.jsonld" },
      "items": { "type": ["string", "object"] }
    },
    "@type": { "const": "Passport" },
    "asset_id": { "$ref": "#/$defs/asset_id" },
    "passport_id": { "type": "string", "pattern": "^LL-[A-Za-z0-9]+-[A-Za-z0-9]+$" },
    "tenant_id": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["unit", "lot"] },
    "quantity": { "$ref": "#/$defs/quantity" },
    "class_name": { "type": "string", "minLength": 1 },
    "sku": { "type": "string", "minLength": 1 },
    "catalog_ref": { "$ref": "#/$defs/catalog_ref" },
    "revision": { "$ref": "#/$defs/revision" },
    "lineage": { "$ref": "#/$defs/lineage" },
    "components": { "type": "array", "items": { "$ref": "#/$defs/component" } },
    "joints": { "type": "array", "items": { "$ref": "#/$defs/joint" } },
    "composition": { "type": "array", "items": { "$ref": "#/$defs/composition_line" } },
    "mass": { "$ref": "#/$defs/mass" },
    "dimensions": { "$ref": "#/$defs/dimensions" },
    "condition_grade": { "enum": ["A", "B", "C"] },
    "connect_spec": { "type": "string", "minLength": 1 },
    "recovery_method": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/recovery_method" } },
    "design_ref": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/design_ref" } },
    "controlled": { "$ref": "#/$defs/controlled" },
    "origin": { "$ref": "#/$defs/origin" },
    "carrier": { "$ref": "#/$defs/carrier" },
    "owner": { "$ref": "#/$defs/owner" },
    "manufacturer": { "$ref": "#/$defs/party_ref" },
    "designer": { "$ref": "#/$defs/party_ref" },
    "status": { "$ref": "#/$defs/status" },
    "lifecycle": { "$ref": "#/$defs/lifecycle" },
    "open_exceptions": { "type": "array", "items": { "$ref": "#/$defs/event_id" } },
    "data_grants": { "type": "array", "items": { "$ref": "#/$defs/data_grant" } }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "lot" } }, "required": ["kind"] }, "then": { "required": ["quantity"] } },
    { "anyOf": [{ "required": ["catalog_ref"] }, { "required": ["class_name"] }] }
  ],
  "$defs": {
    "asset_id": { "type": "string", "pattern": "^ast_[0-9A-HJKMNP-TV-Z]{26}$" },
    "event_id": { "type": "string", "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$" },
    "party_id": { "type": "string", "pattern": "^pty_[0-9A-HJKMNP-TV-Z]{26}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "quantity": {
      "type": "object",
      "required": ["value", "uom"],
      "additionalProperties": false,
      "properties": { "value": { "type": "number", "exclusiveMinimum": 0 }, "uom": { "type": "string", "minLength": 1 } }
    },
    "joint_type_term": { "type": "string", "pattern": "^https://loopledger\\.org/vocab/joint_type/(v[0-9]+(\\.[0-9]+)*/)?[a-z][a-z0-9_]*$" },
    "material_term": { "type": "string", "pattern": "^https://loopledger\\.org/vocab/material/(v[0-9]+(\\.[0-9]+)*/)?[a-z][a-z0-9_]*$" },
    "cause_term": { "type": "string", "pattern": "^https://loopledger\\.org/vocab/cause/(v[0-9]+(\\.[0-9]+)*/)?[a-z][a-z0-9_]*$" },
    "cause": {
      "$comment": "design_addressable is copied from the cause scheme at the time of the event; an event carrying true needs photo evidence (event.schema.json).",
      "type": "object",
      "required": ["term", "design_addressable"],
      "additionalProperties": false,
      "properties": { "term": { "$ref": "#/$defs/cause_term" }, "design_addressable": { "type": "boolean" } }
    },
    "catalog_ref": {
      "type": "object",
      "required": ["catalog_id", "version"],
      "additionalProperties": false,
      "properties": {
        "catalog_id": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "supersedes": { "type": "string", "minLength": 1 }
      }
    },
    "recovery_method": {
      "$comment": "One entry per method (SPEC-data-model.md §2 CATALOG_ITEM). declared_labor_min is the designer's or supplier's estimate; the planner prefers the measured figure once its cohort qualifies.",
      "type": "object",
      "required": ["method", "declared_labor_min"],
      "additionalProperties": false,
      "properties": {
        "method": { "enum": ["intact", "destructive"] },
        "cluster": { "type": "string", "minLength": 1 },
        "sequence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "tools": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "crew_size": { "type": "integer", "minimum": 1 },
        "declared_labor_min": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "design_ref": {
      "$comment": "How a feedback adapter finds the object in the design tool: an IFC type GUID, a bSDD class or a CAD/PLM part number.",
      "type": "object",
      "required": ["scheme", "value"],
      "additionalProperties": false,
      "properties": {
        "scheme": { "enum": ["ifc_type_guid", "bsdd_class", "part_number"] },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "revision": {
      "$comment": "The physical design generation (G4, G5). basis says how we know; unknown carries no label and plans as the slowest known revision.",
      "type": "object",
      "required": ["basis"],
      "additionalProperties": false,
      "properties": {
        "basis": { "enum": ["declared", "observed", "unknown"] },
        "label": { "type": "string", "minLength": 1 }
      },
      "if": { "properties": { "basis": { "const": "unknown" } } },
      "then": { "not": { "required": ["label"] } },
      "else": { "required": ["label"] }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parent_asset": { "$ref": "#/$defs/asset_id" },
        "merged_into": { "$ref": "#/$defs/asset_id" }
      }
    },
    "component": {
      "type": "object",
      "required": ["component_id", "material", "mass_kg", "qty"],
      "additionalProperties": false,
      "properties": {
        "component_id": { "type": "string", "minLength": 1 },
        "catalog_ref": { "$ref": "#/$defs/catalog_ref" },
        "material": { "$ref": "#/$defs/material_term" },
        "mass_kg": { "type": "number", "exclusiveMinimum": 0 },
        "qty": { "type": "integer", "minimum": 1 }
      }
    },
    "joint": {
      "type": "object",
      "required": ["joint_id", "type", "between", "count", "reversible"],
      "additionalProperties": false,
      "properties": {
        "joint_id": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/joint_type_term" },
        "between": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string", "minLength": 1 } },
        "count": { "type": "integer", "minimum": 1 },
        "reversible": { "type": "boolean" },
        "tool": { "type": "string", "minLength": 1 }
      }
    },
    "substance": {
      "type": "object",
      "required": ["cas", "name", "mass_pct"],
      "additionalProperties": false,
      "properties": {
        "cas": { "type": "string", "pattern": "^[0-9]{2,7}-[0-9]{2}-[0-9]$" },
        "name": { "type": "string", "minLength": 1 },
        "mass_pct": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }
      }
    },
    "composition_line": {
      "type": "object",
      "required": ["material", "mass_pct"],
      "additionalProperties": false,
      "properties": {
        "material": { "$ref": "#/$defs/material_term" },
        "mass_pct": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "substances": { "type": "array", "items": { "$ref": "#/$defs/substance" } }
      }
    },
    "mass": {
      "type": "object",
      "required": ["value_kg", "basis"],
      "additionalProperties": false,
      "properties": {
        "value_kg": { "type": "number", "exclusiveMinimum": 0 },
        "basis": { "enum": ["estimated", "verified"] },
        "weighed_event": { "$ref": "#/$defs/event_id" }
      }
    },
    "dimensions": {
      "type": "object",
      "required": ["length_cm", "width_cm", "height_cm"],
      "additionalProperties": false,
      "properties": {
        "length_cm": { "type": "number", "exclusiveMinimum": 0 },
        "width_cm": { "type": "number", "exclusiveMinimum": 0 },
        "height_cm": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "controlled": {
      "type": "object",
      "required": ["value"],
      "additionalProperties": false,
      "properties": { "value": { "type": "boolean" }, "policy_id": { "type": "string", "minLength": 1 } },
      "if": { "properties": { "value": { "const": true } } },
      "then": { "required": ["policy_id"] }
    },
    "origin": {
      "type": "object",
      "required": ["site_id", "source_event"],
      "additionalProperties": false,
      "properties": {
        "site_id": { "type": "string", "minLength": 1 },
        "installed_on": { "type": "string", "format": "date" },
        "source_event": { "$ref": "#/$defs/event_id" }
      }
    },
    "carrier": {
      "$comment": "identifier is the ISO/IEC 15459 identifier; digital_link is its GS1 Digital Link URI (GTIN-14 + serial), which resolves without LoopLedger hosting.",
      "type": "object",
      "required": ["kind", "identifier", "digital_link"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["qr", "nfc", "rfid", "etched"] },
        "identifier": { "type": "string", "pattern": "^\\(01\\)[0-9]{14}\\(21\\)[\\x21-\\x7E]{1,20}$" },
        "digital_link": { "type": "string", "format": "uri", "pattern": "^https://[^/\\s]+/01/[0-9]{14}/21/[A-Za-z0-9._~%-]{1,20}$" },
        "position": { "type": "string", "minLength": 1 }
      }
    },
    "party_ref": {
      "type": "object",
      "required": ["party_id"],
      "additionalProperties": false,
      "properties": { "party_id": { "$ref": "#/$defs/party_id" }, "name": { "type": "string", "minLength": 1 } }
    },
    "party_role": { "enum": ["site_operator", "crew", "contractor", "receiver", "hauler", "verifier", "program_owner", "counsel", "adapter", "manufacturer", "designer", "owner"] },
    "owner": {
      "type": "object",
      "required": ["party_id", "record_access"],
      "additionalProperties": false,
      "properties": {
        "party_id": { "$ref": "#/$defs/party_id" },
        "name": { "type": "string", "minLength": 1 },
        "record_access": { "enum": ["full", "append_observations", "read_only"] }
      }
    },
    "status": {
      "$comment": "Where the asset is in this recovery event's workflow. Never a loop route; those live in lifecycle.loop_route.",
      "enum": ["cataloged", "scheduled", "removed", "in_transit", "next_use_assigned"]
    },
    "lifecycle": {
      "$comment": "Where the asset is in its material life. Disposal is a verdict the router reaches, so it appears only as disposal_last_resort and always comes with an exception.",
      "type": "object",
      "required": ["life_used_pct", "life_number", "loop_route"],
      "additionalProperties": false,
      "properties": {
        "life_used_pct": { "type": "number", "minimum": 0 },
        "life_number": { "type": "integer", "minimum": 1 },
        "loop_route": { "enum": ["reuse", "remanufacture", "recycle", "disposal_last_resort"] }
      }
    },
    "data_grant": {
      "type": "object",
      "required": ["grant_id", "tenant_id", "grantee_party_id", "scope", "fields", "purpose", "expires", "signatures"],
      "additionalProperties": false,
      "properties": {
        "grant_id": { "type": "string", "minLength": 1 },
        "tenant_id": { "type": "string", "minLength": 1 },
        "grantee_party_id": { "$ref": "#/$defs/party_id" },
        "grantee_role": { "enum": ["manufacturer", "designer", "financier", "verifier"] },
        "scope": {
          "type": "object",
          "required": ["catalog_ids"],
          "additionalProperties": false,
          "properties": {
            "catalog_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "revisions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["performance", "causes", "fractions", "labor", "residual_value"] }
        },
        "purpose": { "type": "string", "minLength": 1 },
        "expires": { "$ref": "#/$defs/timestamp" },
        "signatures": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "event.schema.json#/$defs/signature" },
          "allOf": [
            { "contains": { "properties": { "role_at_signing": { "const": "tenant" } }, "required": ["role_at_signing"] } },
            { "contains": { "properties": { "role_at_signing": { "const": "grantee" } }, "required": ["role_at_signing"] } }
          ]
        }
      }
    }
  }
}
